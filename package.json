{
  "name": "thief",
  "version": "4.0.0",
  "author": "SanJin <lauixData@gamil.com>",
  "description": "一款真正的创新摸鱼神器",
  "license": "MIT",
  "main": "./dist/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node .electron-vue/build.js && electron-builder",
    "build:win64": "node .electron-vue/build.js && electron-builder --win --x64",
    "build:win32": "node .electron-vue/build.js && electron-builder --win --ia32",
    "build:linux64": "node .electron-vue/build.js && electron-builder --linux --x64",
    "build:linux32": "node .electron-vue/build.js && electron-builder --linux --ia32",
    "build:mac": "node .electron-vue/build.js && electron-builder --mac --x64",
    "build:all": "node .electron-vue/build.js && electron-builder --platform=all",
    "build:dir": "node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean node .electron-vue/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vue/build.js",
    "dev": "node .electron-vue/dev-runner.js",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --progress --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --progress --config .electron-vue/webpack.renderer.config.js",
    "postinstall": ""
  },
  "build": {
    "productName": "thief",
    "appId": "c.team.thief",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "axios": "^0.18.0",
    "element-ui": "^2.9.1",
    "fs-extra": "^8.0.1",
    "hotkeys-js": "^3.7.6",
    "iconv-lite": "^0.5.0",
    "lodash-id": "^0.14.0",
    "lowdb": "^1.0.0",
    "pdfjs-dist": "^2.3.200",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "vue": "^2.5.16",
    "vue-electron": "^1.0.6",
    "vue-router": "^3.0.1",
    "vuex": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^9.2.1",
    "cfonts": "^2.1.2",
    "chalk": "^2.4.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.5",
    "del": "^3.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^4.0.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "multispinner": "^0.2.1",
    "sass": "^1.107.0",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "2.7.16",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.7",
    "webpack-hot-middleware": "^2.26.1"
  }
}
